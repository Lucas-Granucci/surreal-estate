  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary button with shipped hover, focus and pressed states.",
      "html": "<button class=\"ds-primary\">Research an address</button>",
      "css": ".ds-primary{font:500 14px/1.4 \"IBM Plex Sans\", Arial, sans-serif;min-height:44px;border:1px solid var(--control, #858591);border-radius:6px;padding:10px 16px;cursor:pointer;transition:background .15s,border-color .15s;background:var(--accent, #303038);color:var(--onaccent, #ffffff);border-color:var(--accent, #303038);}.ds-primary:hover{background:var(--text, #1d1d20);}.ds-primary:focus-visible{outline:3px solid var(--focus, #3269d7);outline-offset:3px;}.ds-primary:active{transform:translateY(1px);}.ds-primary:disabled{color:var(--disabled, #73737f);background:var(--disabledBg, #e9e9ed);border-color:var(--border, #dadae0);cursor:not-allowed;}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary button with shipped hover, focus and pressed states.",
      "html": "<button class=\"ds-secondary\">Research an address</button>",
      "css": ".ds-secondary{font:500 14px/1.4 \"IBM Plex Sans\", Arial, sans-serif;min-height:44px;border:1px solid var(--control, #858591);border-radius:6px;padding:10px 16px;cursor:pointer;transition:background .15s,border-color .15s;background:var(--surface, #ffffff);color:var(--text, #1d1d20);border-color:var(--border, #dadae0);}.ds-secondary:hover{background:var(--hover, #f1f1f4);}.ds-secondary:focus-visible{outline:3px solid var(--focus, #3269d7);outline-offset:3px;}.ds-secondary:active{transform:translateY(1px);}.ds-secondary:disabled{color:var(--disabled, #73737f);background:var(--disabledBg, #e9e9ed);border-color:var(--border, #dadae0);cursor:not-allowed;}"
    },
    {
      "name": "Text button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Text button with shipped hover, focus and pressed states.",
      "html": "<button class=\"ds-text\">Research an address</button>",
      "css": ".ds-text{font:500 14px/1.4 \"IBM Plex Sans\", Arial, sans-serif;min-height:44px;border:1px solid var(--control, #858591);border-radius:6px;padding:10px 16px;cursor:pointer;transition:background .15s,border-color .15s;background:transparent;color:var(--text, #1d1d20);border-color:transparent;}.ds-text:hover{background:var(--selected, #ececf0);}.ds-text:focus-visible{outline:3px solid var(--focus, #3269d7);outline-offset:3px;}.ds-text:active{transform:translateY(1px);}.ds-text:disabled{color:var(--disabled, #73737f);background:var(--disabledBg, #e9e9ed);border-color:var(--border, #dadae0);cursor:not-allowed;}"
    },
    {
      "name": "Address field",
      "kind": "input",
      "refersTo": "field",
      "description": "Address or saved-report search field.",
      "html": "<input class=\"ds-field\" type=\"text\" aria-label=\"Address\" placeholder=\"Street address\">",
      "css": ".ds-field{font:17px/1.5 \"IBM Plex Sans\", Arial, sans-serif;width:100%;min-height:52px;border:1px solid var(--control, #858591);background:var(--surface, #ffffff);color:var(--text, #1d1d20);padding:14px 16px;border-radius:6px;}.ds-field:focus-visible{outline:3px solid var(--focus, #3269d7);outline-offset:3px;}.ds-field[aria-invalid=\"true\"]{border-color:var(--error, #b42e3e);}"
    },
    {
      "name": "Report navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Current report view with selected fill and graphite edge.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Report\"><button aria-current=\"page\">Findings</button><button>Sources</button></nav>",
      "css": ".ds-nav{display:grid;gap:5px;padding:27px 14px;background:var(--bg, #f6f6f7);}.ds-nav button{font:500 14px/1.4 \"IBM Plex Sans\", Arial, sans-serif;min-height:44px;border:1px solid var(--control, #858591);border-radius:6px;padding:10px 16px;cursor:pointer;transition:background .15s,border-color .15s;text-align:left;background:transparent;border-color:transparent;color:var(--text, #1d1d20);font-weight:400;}.ds-nav button[aria-current]{background:var(--selected, #ececf0);font-weight:500;border-left:2px solid var(--accent, #303038);}.ds-nav button:hover{background:var(--hover, #f1f1f4);}.ds-nav button:focus-visible{outline:3px solid var(--focus, #3269d7);outline-offset:3px;}"
    },
    {
      "name": "Research choice",
      "kind": "custom",
      "refersTo": "channel",
      "description": "Conventional native checkbox with concise context.",
      "html": "<label class=\"ds-channel\"><input type=\"checkbox\" checked><span><strong>Public records &amp; nearby places</strong><p>Property and permit records, mapped surroundings and flood-map context.</p></span></label>",
      "css": ".ds-channel{display:flex;gap:16px;padding:23px 18px;border:1px solid transparent;border-radius:7px;font:16px/1.5 \"IBM Plex Sans\", Arial, sans-serif;color:var(--text, #1d1d20);cursor:pointer;}.ds-channel:has(:checked){background:var(--selected, #ececf0);border-color:var(--control, #858591);}.ds-channel:hover{background:var(--hover, #f1f1f4);}.ds-channel input{width:19px;height:19px;flex-shrink:0;accent-color:var(--accent, #303038);margin:4px 0;}.ds-channel input:focus-visible{outline:3px solid var(--focus, #3269d7);outline-offset:3px;}.ds-channel strong{font-size:17px;font-weight:500;}.ds-channel p{font-size:14px;color:var(--muted, #60606b);margin:6px 0 0;max-width:42ch;}"
    },
    {
      "name": "Preview container",
      "kind": "card",
      "refersTo": "preview-card",
      "description": "Quiet framed report preview; no fabricated findings.",
      "html": "<article class=\"ds-preview\"><header>Evidence Bench</header><div>Research an address to see its records and available evidence here.</div></article>",
      "css": ".ds-preview{font:16px/1.5 \"IBM Plex Sans\", Arial, sans-serif;color:var(--text, #1d1d20);background:var(--surface, #ffffff);border:1px solid var(--border, #dadae0);border-radius:10px;overflow:hidden;box-shadow:0 14px 40px #00000006;}.ds-preview header{padding:15px 24px;border-bottom:1px solid var(--border, #dadae0);font-size:13px;color:var(--muted, #60606b);}.ds-preview div{padding:28px;}"
    }
  ],
  "narrative": {
    "northStar": "Evidence Bench",
    "overview": "The Evidence Bench puts concise findings beside inspectable evidence. Graphite controls, quiet neutral surfaces and IBM Plex Sans create a restrained working interface with a confident editorial landing page. The system follows the operating system’s light or dark preference without a theme toggle.\n\nThe user-approved `design/SurrealEstate.html` establishes the visual world. The shipped stylesheet and application retain its composition and components while binding them to real saved reports, research progress and source records. PRODUCT.md remains the authority for product truth.",
    "keyCharacteristics": [
      "Graphite actions and layered neutral surfaces in two system-controlled themes.",
      "IBM Plex Sans throughout, with large landing typography and compact evidence reading.",
      "An Evidence Bench with navigation, findings and a source inspector.",
      "Conventional choices and progressive disclosure that keep qualifications visible."
    ],
    "rules": [
      {
        "name": "The System Theme Rule",
        "body": "Follow the system preference using the paired light and dark tokens; provide no manual theme switch.",
        "section": "colors"
      },
      {
        "name": "The Evidence Meaning Rule",
        "body": "Use readable source and status labels; color never upgrades uncertain evidence into a fact.",
        "section": "colors"
      },
      {
        "name": "The Bench Depth Rule",
        "body": "Keep the report’s structure in borders and tonal surfaces; reserve floating elevation for the preview and dialog patterns already present.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the approved graphite palette and system-controlled themes.",
      "Do keep source classes, missing data and address estimates explicit.",
      "Do pair concise findings with reachable evidence and complete source records.",
      "Do preserve keyboard focus, native controls and reduced-motion behavior."
    ],
    "donts": [
      "Don’t add a theme toggle or revive the superseded green action palette.",
      "Don’t substitute system display typography for IBM Plex Sans.",
      "Don’t invent report content, travel times or generation percentages.",
      "Don’t present model accounts as independently verified findings or permits as active work."
    ]
  }
}
