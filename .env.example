# The CLI loads .env from the current directory. Exported variables take precedence.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=nemotron-3-nano:4b
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# Census, WPRDC assessments/permits/closures, FEMA and OSM need no API keys.

# Final brief writing only: no Google Search/grounding tools.
GEMINI_API_KEY=
GEMINI_SYNTHESIS_MODEL=gemini-3.8-flash
